# =============================================================
#  JalDrishti-AI — Environment Configuration EXAMPLE
#  Copy this file to .env and fill in your real credentials.
#  NEVER commit the actual .env file.
# =============================================================

# --- IBM watsonx.ai ---
WATSONX_PROJECT_ID=d35a6f68-c129-4634-b823-ff9583f7fde6
WATSONX_URL=https://us-south.ml.cloud.ibm.com
WATSONX_API_KEY=your_ibm_cloud_api_key_here

# --- IBM Watson Machine Learning ---
IBM_WATSON_ML_API_KEY=your_ibm_watson_ml_api_key_here
IBM_WATSON_ML_URL=https://us-south.ml.cloud.ibm.com
IBM_WATSON_ML_INSTANCE_ID=your_watson_ml_instance_id_here
IBM_WATSON_ML_SPACE_ID=your_watson_ml_space_id_here

# --- IBM Cloud Object Storage ---
IBM_COS_API_KEY=your_ibm_cos_api_key_here
IBM_COS_INSTANCE_ID=your_cos_resource_instance_id_here
IBM_COS_ENDPOINT=https://s3.us-south.cloud-object-storage.appdomain.cloud
IBM_COS_AUTH_ENDPOINT=https://iam.cloud.ibm.com/identity/token
IBM_COS_BUCKET_NAME=jaldrishti-data-bucket

# --- IBM Db2 on Cloud ---
IBM_DB2_HOST=your_db2_hostname.databases.appdomain.cloud
IBM_DB2_PORT=50001
IBM_DB2_DATABASE=bludb
IBM_DB2_USERNAME=your_db2_username_here
IBM_DB2_PASSWORD=your_db2_password_here
IBM_DB2_SSL=True

# --- IBM Watson Assistant ---
IBM_ASSISTANT_API_KEY=your_ibm_assistant_api_key_here
IBM_ASSISTANT_URL=https://api.us-south.assistant.watson.cloud.ibm.com/instances/your_instance_id
IBM_ASSISTANT_ENVIRONMENT_ID=your_environment_id_here

# --- Flask ---
FLASK_APP=app.py
FLASK_ENV=development
FLASK_DEBUG=True
SECRET_KEY=change_this_to_a_random_secret_string
PORT=5000

# --- Dataset ---
DATASET_PATH=data/nss78_21.xlsx
MIS_ROUND=78
SURVEY_YEAR=2023

# --- AI/ML ---
MODEL_DEPLOYMENT_ID=your_deployed_model_id_here
PREDICTION_THRESHOLD=0.75
